+/* No QDMA1/GPON control changes: only LAN CPU -> PPE channel7, queue0. */
+int airoha_whnat_xmit(struct econet_qdma *qdma, struct sk_buff *skb)
+{
+	union desc_msg msg = {};
+	int ret;
+	if (qdma->common.id || !READ_ONCE(qdma->users))
+		return -EOPNOTSUPP;
+	set_etx_channel(&msg.etx, 7);
+	set_etx_queue(&msg.etx, 0);
+	set_etx_fport(&msg.etx, ETX_FPORT_PPE);
+	ret = airoha_qdma_gen1_xmit(qdma, skb, &msg, 0, NULL);
+	/* Positive EBUSY means consumed + ring now full. A positive DMA-map
+	 * error is NOT a successful handoff and must restore the original skb. */
+	return ret == 0 || ret == EBUSY ? ret : ret < 0 ? ret : -EIO;
+}
