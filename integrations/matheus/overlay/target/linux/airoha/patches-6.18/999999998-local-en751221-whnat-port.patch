From: Cristian Papa <pcristian292@gmail.com>
Subject: [PATCH] net: airoha: add opt-in EN751221 WHNAT datapath

Port pre-GRO ownership, batched FCPU WiFi delivery and devless descriptor
reserve from the documented XR500v path. Preserve xPON egress and QDMA1.
Hardware validation pending: default off, first packet budget 32.

--- a/drivers/net/ethernet/airoha/Makefile
+++ b/drivers/net/ethernet/airoha/Makefile
@@ -4,7 +4,7 @@
 #
 
 obj-$(CONFIG_NET_AIROHA) += airoha-eth.o
-airoha-eth-y := airoha_common.o airoha_ppe.o airoha_eth.o airoha_qdma.o \
+airoha-eth-y := airoha_common.o airoha_ppe.o airoha_whnat.o airoha_eth.o airoha_qdma.o \
 		airoha_eth_gen1.o airoha_eth_gen2.o
 airoha-eth-$(CONFIG_NET_AIROHA_PPE_DEBUGFS) += airoha_ppe_debugfs.o
 airoha-eth-$(CONFIG_NET_AIROHA_SOC_WED) += airoha_wed.o airoha_wed_debugfs.o
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -19,6 +19,7 @@
 
 #include "airoha_regs.h"
 #include "airoha_eth.h"
