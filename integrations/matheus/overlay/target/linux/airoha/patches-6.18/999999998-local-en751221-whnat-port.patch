 /* Serialize airoha_gdm_dev flags, QDMA pointer and PPE CPU port
  * configuration.
@@ -2835,6 +2836,21 @@
 	flow->hash = EN751221_PPE_INVALID_HASH;
 }
 
+void airoha_whnat_invalidate_vif(struct econet_ppe *ppe, int idx)
+{
+	struct econet_flow_entry *flow, *next;
+	spin_lock_bh(&ppe->lock);
+	list_for_each_entry_safe(flow, next, &ppe->flows, list) {
+		if (flow->data.ipv4.l2.etype != htons(0x5678) ||
+		    flow->data.ipv4.l2.vlan1 != idx)
+			continue;
+		econet_ppe_release_flow_slot(ppe, flow, true);
+		list_del(&flow->list);
+		kfree(flow);
+	}
+	spin_unlock_bh(&ppe->lock);
+}
+
 static u16 econet_ppe_find_bind_way(struct econet_ppe *ppe,
 				    struct econet_flow_entry *flow, u16 hash,
 				    struct econet_foe_entry *lookup_raw,
@@ -3277,12 +3293,26 @@
 {
 	struct airoha_gdm_common *gdm;
 	struct dsa_port *dp;
-	int dsa_port = -1;
+	int dsa_port = -1, wifi_idx;
 	int err;
 
 	*xpon = false;
 	if (!odev)
 		return -EOPNOTSUPP;
+	wifi_idx = airoha_whnat_active() ? airoha_whnat_vif_index(odev) : -1;
+	if (wifi_idx >= 0) {
+		if (vlan_valid) return -EOPNOTSUPP;
+		/* Proven EN751221 FCPU recipe: dp=0, fqos=0; resolve BSS from
+		 * the egress netdevice, never the shared bridge's source MAC. */
+		econet_foe_entry_set_pse_port(entry, 0);
+		entry->ipv4.ib2 &= ~EN751221_FOE_IB2_PSE_QOS;
+		entry->ipv4.l2.vlan1 = wifi_idx;
+		entry->ipv4.l2.etype = htons(0x5678);
+		entry->ib1 &= ~EN751221_FOE_IB1_BIND_VLAN_LAYER;
+		entry->ib1 |= EN751221_FOE_IB1_BIND_VLAN_TAG |
+			FIELD_PREP(EN751221_FOE_IB1_BIND_VLAN_LAYER, 1);
+		return 0;
+	}
 
 	if (dsa_user_dev_check(odev)) {
 		dp = dsa_port_from_netdev(odev);
@@ -3731,6 +3761,8 @@
 
 	dev_info(dev, "PPE FoE table at %pad, %u entries\n",
 		 &ppe->common.foe_dma, dram_entries);
+	if (airoha_is(eth, econet_en751221))
+		airoha_whnat_set_ppe(ppe);
 	return 0;
 }
 
